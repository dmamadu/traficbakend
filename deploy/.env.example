# /opt/invodis/.env — à créer sur le VPS (chmod 600), JAMAIS dans Git.
# Mettre des secrets NEUFS : ceux de application.properties.prod (TEC-04) sont à considérer comme exposés.

# Versions déployées (mises à jour par deploy.sh)
BACKEND_TAG=latest
FRONTEND_TAG=latest

# MySQL
MYSQL_ROOT_PASSWORD=changeme
DATASOURCE_USERNAME=invodis_user
DATASOURCE_PASSWORD=changeme

# E-mail (TEC-02 : l'expéditeur se change ici)
MAIL_USERNAME=support@invodis.com
MAIL_PASSWORD=changeme

# MinIO
MINIO_ACCESS_KEY=invodis
MINIO_SECRET_KEY=changeme
MINIO_BUCKET_NAME=invodisfiles

# JWT (openssl rand -base64 64)
JWT_SECRET=changeme

# Application
APP_SUPPORT_MAIL=support@invodis.com
APP_FRONT_URL=https://invodis.com
