# Copier ce fichier en .env et renseigner les vraies valeurs.
# Le fichier .env est ignoré par git.

# Base de données MySQL
MYSQL_ROOT_PASSWORD=changeme
DATASOURCE_USERNAME=invodis_user
DATASOURCE_PASSWORD=changeme

# Email (SMTP Gmail)
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=votre_app_password_gmail

# MinIO (stockage fichiers)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET_NAME=invodisfiles

# JWT — clé secrète pour signer les tokens (minimum 64 caractères recommandé)
JWT_SECRET=changeme_use_a_long_random_secret_at_least_64_chars_in_production

# Application
APP_SUPPORT_MAIL=support@invodis.com
APP_FRONT_URL=https://invodis.com

# AWS (laisser les placeholders si non utilisé)
AWS_ACCESS_KEY=placeholder
AWS_SECRET_KEY=placeholder
AWS_REGION=us-east-1
AWS_BUCKET=placeholder

# Optionnel — valeurs par défaut déjà définies dans application.properties
# SERVER_PORT=8081
# JPA_DDL_AUTO=update
# JPA_SHOW_SQL=false
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MINIO_ENDPOINT=http://minio:9000
